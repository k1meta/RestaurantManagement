# Copy this file to .env and fill in your values
# DO NOT commit .env to git

PORT=3000

# Firebase Admin SDK (Firestore)
FIREBASE_PROJECT_ID=restaurantmanagment-ed8bc
# Provide one credential source:
# 1) JSON string (single line) from Firebase service account:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# 1b) Base64-encoded JSON (recommended on Render):
# FIREBASE_SERVICE_ACCOUNT_JSON_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwuLi59
# 2) Path to service account json file:

# 3) Or use Google application default credentials:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Team branch naming suggestion (for documentation/workflow):
# - shared integration: main
# - developer branches: dev-alice, dev-bob

# JWT secret — change this to a long random string
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h
