{
  "name": "restaurant-management-frontend",
  "version": "1.0.0",
  "description": "Restaurant Management App - Frontend",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "cross-env PORT=3001 FAST_REFRESH=false react-scripts start",
    "start:web": "cross-env PORT=3001 FAST_REFRESH=false react-scripts start",
    "start:react": "cross-env PORT=3001 FAST_REFRESH=false react-scripts start",
    "dev": "cross-env PORT=3001 FAST_REFRESH=false react-scripts start",
    "build": "react-scripts build",
    "build:web": "react-scripts build",
    "test": "react-scripts test",
    "mobile:prepare": "node scripts/ensure-mobile-watch-paths.js",
    "mobile:doctor": "npx expo-doctor",
    "mobile:install-expo-go": "node scripts/install-expo-go-android.js",
    "mobile:install-expo-go:apk": "node scripts/install-expo-go-android.js --apk-only",
    "start:mobile": "npm run mobile:prepare && npx expo start --clear",
    "start:mobile:android": "npm run mobile:prepare && npx expo start --clear --android",
    "start:mobile:ios": "npm run mobile:prepare && npx expo start --clear --ios",
    "start:mobile:web": "npm run mobile:prepare && npx expo start --web",
    "start:mobile:ci": "npm run mobile:prepare && cross-env CI=1 npx expo start --clear",
    "build:android": "npx eas-cli build -p android",
    "build:android:apk": "npx eas-cli build -p android --profile preview",
    "build:android:production": "npx eas-cli build -p android --profile production",
    "build:ios": "npx eas-cli build -p ios",
    "build:ios:preview": "npx eas-cli build -p ios --profile preview",
    "submit:android": "npx eas-cli submit -p android",
    "submit:ios": "npx eas-cli submit -p ios",
    "update:production": "eas update --branch production --environment production --message \"Production update\"",
    "deploy:mobile": "eas update --branch production --environment production --message \"Mobile deploy\" && eas build --platform android --profile preview --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo-google-fonts/work-sans": "^0.4.2",
    "@expo/metro-runtime": "~55.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.0",
    "axios": "^1.16.0",
    "expo": "^55.0.24",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "babel-preset-expo": "^56.0.11",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "latest",
    "electron-builder": "latest",
    "react-scripts": "5.0.1",
    "wait-on": "^9.0.10"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
