# Copy this file to .env and fill in your values
# DO NOT commit .env to git

PORT=3000

# PostgreSQL connection (preferred: Neon)
# Use Neon pooled connection string for shared/team environments.
DATABASE_URL=postgresql://neondb_owner:npg_e4PJGqfX7vMy@ep-fancy-hat-alk7heh4.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optional fallback for local PostgreSQL only (used when DATABASE_URL is missing).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Optional: set to "disable" only for local non-SSL DBs.
# Keep unset for Neon.
DB_SSLMODE=

# Team branch naming suggestion (for documentation/workflow):
# - shared integration: main
# - developer branches: dev-alice, dev-bob

# JWT secret — change this to a long random string
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h
